<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with Material 3 Palette -->
    <style name="Base.Theme.CampusPulse" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <item name="colorSecondary">@color/accent_sky_blue</item>
        <item name="colorSecondaryContainer">@color/accent_container</item>
        <item name="colorOnSecondaryContainer">@color/on_accent_container</item>

        <item name="android:colorBackground">@color/surface_bg</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/on_surface</item>

        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <!-- Status & Navigation Bar -->
        <item name="android:statusBarColor">@color/surface_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.CampusPulse" parent="Base.Theme.CampusPulse" />

    <style name="ShapeAppearanceOverlay.App.CornerTop16" parent="">
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.Corner14" parent="">
        <item name="cornerSize">14dp</item>
    </style>
</resources>